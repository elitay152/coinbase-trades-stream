        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\r\n  SELECT date_trunc('minute', $__timeFrom()::timestamptz) AS lo,\r\n         date_trunc('minute', now()) - INTERVAL '2 minutes' AS hi\r\n),\r\nfirst_seen AS (\r\n  SELECT product_id, MIN(window_start) AS start_window\r\n  FROM candles, bounds\r\n  WHERE window_start >= bounds.lo AND product_id IN ($product_id)\r\n  GROUP BY product_id\r\n),\r\nexpected AS (\r\n  SELECT f.product_id, w AS window_start\r\n  FROM first_seen f, bounds b,\r\n       generate_series(f.start_window, b.hi, INTERVAL '1 minute') AS w\r\n)\r\nSELECT e.product_id, COUNT(*) FILTER (WHERE c.window_start IS NULL) AS missing_candles\r\nFROM expected e\r\nLEFT JOIN candles c USING (product_id, window_start)\r\nGROUP BY e.product_id\r\nORDER BY e.product_id",
          "refId": "A",
